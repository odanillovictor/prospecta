{
  "manifest_version": 3,
  "name": "Prospecta Robô",
  "version": "0.2.0",
  "description": "Ponte entre o Prospecta e o WhatsApp Web do seu Chrome. Só conversa com o serviço local (127.0.0.1:8791).",
  "permissions": ["storage", "tabs", "scripting"],
  "host_permissions": ["https://web.whatsapp.com/*", "http://127.0.0.1:8791/*", "https://www.instagram.com/*", "https://*.cdninstagram.com/*", "https://*.fbcdn.net/*"],
  "background": { "service_worker": "bg.js" },
  "content_scripts": [
    { "matches": ["https://web.whatsapp.com/*"], "js": ["wa.js"], "run_at": "document_idle" }
  ]
}
